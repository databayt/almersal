{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almersal",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // mr.databayt.org — the Project card on databayt.org. custom_domain makes
  // Cloudflare own the hostname's DNS record (it was a dead CNAME to Vercel).
  "routes": [
    { "pattern": "mr.databayt.org", "custom_domain": true }
  ]
}
